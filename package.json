{
  "name": "wingman",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "youcam:smoke": "tsx --conditions=react-server --env-file=.env.local scripts/youcam-smoke.ts",
    "photo:check": "tsx --conditions=react-server --env-file=.env.local scripts/check-photo.ts",
    "stores:check": "tsx --conditions=react-server --env-file=.env.local scripts/check-stores.ts",
    "catalog:fetch": "tsx --conditions=react-server --env-file=.env.local scripts/fetch-catalog.ts",
    "style:demo": "tsx scripts/style-demo.ts",
    "catalog:colours": "tsx --conditions=react-server --env-file=.env.local scripts/backfill-colours.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "cn": "^0.5.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
