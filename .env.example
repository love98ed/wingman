# Copy to .env.local and fill in. Everything except NEXT_PUBLIC_* stays server-side.
YOUCAM_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MOCK_YOUCAM=false          # true serves saved fixtures (no units) for UI work; false in production
YOUCAM_UNIT_LIMIT=700      # hard stop
